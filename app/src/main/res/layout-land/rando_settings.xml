<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:backgroundTint="#111111"
    android:backgroundTintMode="add"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/backgroundSecondary"
        android:paddingTop="20dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="?attr/android:textColorPrimary"
        app:tabTextColor="@color/gray_100" />

    <ScrollView
        android:id="@+id/settingsPanelScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:background="?attr/android:background">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/android:background"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/backgroundSecondary"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/android:colorPrimary"
            android:text="Back To Menu"
            android:textColor="?attr/primaryButtonTextColor" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/android:colorPrimary"
            android:text="Save Settings"
            android:textColor="?attr/primaryButtonTextColor" />
    </LinearLayout>

</LinearLayout>