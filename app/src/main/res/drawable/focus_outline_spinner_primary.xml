<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <stroke android:width="3dp" android:color="?attr/focusOutline"/>
                </shape>
            </item>

            <item android:drawable="@drawable/drop_down_arrow"
                android:gravity="end|center_vertical"
                android:right="12dp" />
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <stroke android:width="0dp" android:color="@android:color/transparent"/>
                </shape>
            </item>

            <item
                android:drawable="@drawable/drop_down_arrow"
                android:gravity="end|center_vertical"
                android:right="12dp"
                android:width="24dp"
                android:height="24dp" />
        </layer-list>
    </item>
</selector>
